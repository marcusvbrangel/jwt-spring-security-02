{
  "info": {
    "_postman_id": "b1e2c3d4-5678-1234-9abc-def012345678",
    "name": "JWT Spring Security API",
    "description": "Coleção de endpoints para testar autenticação, usuários e produtos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login (Auth)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "Criar Usuário (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"novo\",\n  \"password\": \"senha\",\n  \"roles\": [\"USER\"]\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/auth/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "auth", "users"]
        }
      }
    },
    {
      "name": "Criar Produto (USER)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Produto Teste\",\n  \"preco\": 99.99\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "Listar Meus Produtos (USER)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/products/me",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products", "me"]
        }
      }
    },
    {
      "name": "Listar Todos Produtos (ADMIN)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "Atualizar Produto (USER)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Produto Atualizado\",\n  \"preco\": 150.00\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/products/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Excluir Produto (USER)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/products/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products", "{{productId}}"]
        }
      }
    },
    {
      "name": "Endpoint Público",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/v1/products/public",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products", "public"]
        }
      }
    },
    {
      "name": "Endpoint DenyAll",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/v1/products/deny",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "products", "deny"]
        }
      }
    }
  ],
  "variable": [
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" }
  ]
}

